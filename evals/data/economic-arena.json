{
  "bench": "economic-arena",
  "title": "Economic Arena",
  "question": "What happens when agents negotiate against each other for profit?",
  "source": {
    "name": "Multiscalar",
    "label": "Multiscalar",
    "linkText": "original paper idea",
    "url": "https://arxiv.org/abs/2603.20925",
    "snapshot": "2026-08-05",
    "run": "v1"
  },
  "blurb": "Every model plays every other across four economic games, told only the rules, its own private value, and to maximise its own profit. Surplus captured is the share of the available money a model walks away with; 50% is an even split.",
  "footnote": "4400 episodes, 10 models, agent slots balanced within every pairing. Opponents are naive, so no model ever accepted a deal below its own walk-away value.",
  "metrics": [
    {
      "id": "claim_share",
      "label": "Surplus captured (% of feasible)",
      "unit": "%",
      "higherIsBetter": true
    },
    {
      "id": "matrix",
      "label": "Head-to-head",
      "unit": "%",
      "higherIsBetter": true,
      "kind": "matrix"
    }
  ],
