{
  "bench": "zerosum-bench",
  "title": "ZeroSum-Bench",
  "question": "How much money can an agent take from its counterparties?",
  "source": {
    "name": "Multiscalar",
    "label": "Multiscalar",
    "linkText": "original paper idea",
    "url": "https://arxiv.org/abs/2603.20925",
    "snapshot": "2026-09-22",
    "run": "v1",
    "paper": "https://arxiv.org/abs/2603.20925"
  },
  "blurb": "Agents negotiate against each other for profit. The bar is the share of the money changing hands that an agent keeps for itself. 50% is an even split, and a higher bar means it takes more from the agents it faces.",
  "footnote": "Jev 1.13 is TypeSafe's System One decision model. It plays through a fixed menu of prices, sends no messages, and its number is the expected value of the probabilities it puts on the menu. Almost a quarter of its episodes ended with no deal, mostly in the provision-point game; those count as zero for claim share but drop out of the money-extracted denominator. Its episodes are included in every model's average.",
  "metrics": [
    {
      "id": "extracted_of_realised",
      "label": "Money extracted (% of what changed hands)",
      "unit": "%",
      "higherIsBetter": true
    },
    {
      "id": "matrix",
      "label": "Head-to-head",
      "unit": "%",
      "higherIsBetter": true,
      "kind": "matrix"
    }
  ],
  "defaultMetric": "extracted_of_realised",
